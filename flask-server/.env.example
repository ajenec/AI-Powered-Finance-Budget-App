# Copy this file to `.env` and fill in your own values. Never commit real secrets.

# Flask
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too

# Database (example for Postgres)
DATABASE_URL=postgresql://user:password@localhost:5432/finance_app

# AI provider
# Do NOT use a real key here; supply it only in your local `.env`.
OPENAI_API_KEY=your-openai-api-key